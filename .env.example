# Jawa Vocab environment variables
APP_NAME=Jawa Vocab
APP_ENV=development
APP_DEBUG=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_POOL_WARMUP=true

CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Pondoknusa
