<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Learn basic Javanese vocabulary with lessons, games, and short cultural notes.">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <title>@yield('title', 'Jawa Vocab') — Jawa Vocab</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f6f1e7;
      --bg-deep: #ebe2d2;
      --ink: #1f1a14;
      --muted: #5d5348;
      --card: #fffaf2;
      --line: #d9cbb6;
      --brand: #9c2f1a;
      --brand-deep: #6f1f10;
      --accent: #0f6b5c;
      --accent-soft: #d8efe9;
      --gold: #c6922c;
      --shadow: 0 14px 40px rgba(55, 35, 15, 0.08);
      --radius: 18px;
      --max: 1080px;
      font-family: "Source Sans 3", system-ui, sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(198, 146, 44, 0.16), transparent 28%),
        radial-gradient(circle at top right, rgba(15, 107, 92, 0.12), transparent 24%),
        linear-gradient(180deg, #f8f3ea 0%, var(--bg) 40%, #f3ebe0 100%);
      line-height: 1.55;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
    }
    a { color: var(--brand-deep); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
    a:hover { color: var(--brand); }
    img { max-width: 100%; }

    .shell {
      width: min(var(--max), calc(100% - 2rem));
      margin: 0 auto;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(14px);
      background: rgba(246, 241, 231, 0.84);
      border-bottom: 1px solid rgba(217, 203, 182, 0.8);
    }
    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.9rem 0;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: inherit;
      text-decoration: none;
      font-weight: 700;
    }
    .brand-mark {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.9rem;
      display: grid;
      place-items: center;
      background: linear-gradient(145deg, var(--brand), #c45a28);
      color: white;
      font-family: "Fraunces", Georgia, serif;
      box-shadow: var(--shadow);
    }
    .brand-text small {
      display: block;
      color: var(--muted);
      font-weight: 600;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    nav a {
      text-decoration: none;
      color: var(--muted);
      font-weight: 600;
      padding: 0.55rem 0.8rem;
      border-radius: 999px;
    }
    nav a:hover,
    nav a.active {
      background: rgba(156, 47, 26, 0.08);
      color: var(--brand-deep);
    }

    main { padding: 2rem 0 4rem; }

    .hero {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 1.5rem;
      align-items: stretch;
      margin-bottom: 2rem;
    }
    .hero-copy, .hero-panel, .card, .stat, .word-card, .post-card, .game-card {
      background: rgba(255, 250, 242, 0.92);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .hero-copy, .hero-panel { padding: 1.6rem; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }
    h1, h2, h3, .display {
      font-family: "Fraunces", Georgia, serif;
      line-height: 1.15;
      margin: 0 0 0.75rem;
      letter-spacing: -0.02em;
    }
    h1 { font-size: clamp(2.2rem, 4vw, 3.4rem); }
    h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
    p { margin-top: 0; color: var(--muted); }
    .lead { font-size: 1.12rem; max-width: 38rem; }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.4rem;
    }
    .btn {
      appearance: none;
      border: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border-radius: 999px;
      padding: 0.8rem 1.15rem;
      font: inherit;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary {
      background: linear-gradient(135deg, var(--brand), #c45a28);
      color: white;
      box-shadow: 0 10px 24px rgba(156, 47, 26, 0.24);
    }
    .btn-secondary {
      background: white;
      color: var(--ink);
      border: 1px solid var(--line);
    }
    .btn-accent {
      background: var(--accent);
      color: white;
    }
    .btn-ghost {
      background: transparent;
      color: var(--brand-deep);
      border: 1px dashed var(--line);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin: 1.2rem 0 0;
    }
    .stat { padding: 1rem; }
    .stat strong {
      display: block;
      font-family: "Fraunces", Georgia, serif;
      font-size: 1.7rem;
    }
    .stat span { color: var(--muted); font-size: 0.92rem; }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
      margin: 2rem 0 1rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .card, .word-card, .post-card, .game-card { padding: 1.2rem; }
    .card h3, .word-card h3, .post-card h3, .game-card h3 { margin-bottom: 0.4rem; }
    .meta {
      color: var(--muted);
      font-size: 0.92rem;
    }
    .pill-row, .choice-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      background: var(--bg-deep);
      color: var(--muted);
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
    }
    .pill:hover, .pill.active {
      background: rgba(156, 47, 26, 0.1);
      color: var(--brand-deep);
    }

    .word-card .jv {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--ink);
    }
    .word-card .aksara {
      font-size: 1.5rem;
      color: var(--brand);
      margin: 0.2rem 0 0.5rem;
    }
    .word-card .en {
      color: var(--accent);
      font-weight: 700;
    }
    .example {
      margin-top: 0.8rem;
      padding-top: 0.8rem;
      border-top: 1px dashed var(--line);
      font-size: 0.95rem;
    }

    .post-body {
      background: rgba(255,250,242,0.92);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: clamp(1.2rem, 3vw, 2rem);
    }
    .post-body h2, .post-body h3 { margin-top: 1.4rem; }
    .post-body p, .post-body li { color: var(--ink); }
    .post-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
    }
    .post-body th, .post-body td {
      border: 1px solid var(--line);
      padding: 0.55rem 0.7rem;
      text-align: left;
    }
    .post-body th { background: var(--bg-deep); }

    .game-board {
      display: grid;
      gap: 1rem;
    }
    .match-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .match-col {
      display: grid;
      gap: 0.65rem;
    }
    .tile {
      width: 100%;
      text-align: left;
      border: 1px solid var(--line);
      background: white;
      border-radius: 14px;
      padding: 0.95rem 1rem;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      transition: 0.15s ease;
    }
    .tile:hover { border-color: var(--gold); }
    .tile.selected {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(156, 47, 26, 0.12);
      background: #fff4ee;
    }
    .tile.matched {
      opacity: 0.45;
      background: var(--accent-soft);
      border-color: transparent;
      pointer-events: none;
    }
    .tile.wrong {
      animation: shake 0.35s ease;
      border-color: #b42318;
    }

    .quiz-card, .flash-card, .scorebar {
      background: rgba(255,250,242,0.95);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.3rem;
    }
    .choice {
      width: 100%;
      text-align: left;
      border: 1px solid var(--line);
      background: white;
      border-radius: 14px;
      padding: 0.9rem 1rem;
      font: inherit;
      font-weight: 600;
      cursor: pointer;
    }
    .choice:hover { border-color: var(--gold); }
    .choice.correct {
      background: var(--accent-soft);
      border-color: var(--accent);
    }
    .choice.incorrect {
      background: #fdecea;
      border-color: #b42318;
    }
    .text-input {
      width: 100%;
      margin-top: 0.45rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: white;
      color: var(--ink);
      padding: 0.9rem 1rem;
      font: inherit;
      font-size: 1.1rem;
    }
    .text-input:focus {
      outline: 3px solid rgba(15, 107, 92, 0.18);
      border-color: var(--accent);
    }
    .scramble-letters {
      margin: 1rem 0 1.1rem;
      padding: 1rem;
      border-radius: 14px;
      background: var(--bg-deep);
      color: var(--brand-deep);
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(1.4rem, 4vw, 2rem);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-align: center;
    }
    .sentence-slots {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      align-items: center;
      min-height: 3.5rem;
      margin: 1rem 0 0.65rem;
      padding: 0.7rem;
      border: 1px dashed var(--line);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.55);
    }
    .sentence-slot { width: auto; }
    .word-bank {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      min-height: 3rem;
      padding: 0.7rem 0;
    }
 

    .flash-card {
      min-height: 280px;
      display: grid;
      place-items: center;
      text-align: center;
      cursor: pointer;
      user-select: none;
    }
    .flash-card .prompt {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(2rem, 5vw, 3rem);
    }
    .flash-card .hint { color: var(--muted); margin-top: 0.6rem; }

    .scorebar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 1rem;
    }
    .scorebar strong {
      font-family: "Fraunces", Georgia, serif;
      font-size: 1.4rem;
    }

    .footer {
      border-top: 1px solid var(--line);
      padding: 1.5rem 0 2.5rem;
      color: var(--muted);
      font-size: 0.95rem;
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .empty {
      padding: 1.4rem;
      border-radius: var(--radius);
      border: 1px dashed var(--line);
      background: rgba(255,255,255,0.5);
      color: var(--muted);
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }

    @media (max-width: 800px) {
      .hero, .match-grid, .stats { grid-template-columns: 1fr; }
      .topbar-inner { align-items: flex-start; flex-direction: column; }
      nav { width: 100%; }
    }
  </style>
  @stack('styles')
</head>
<body>
  <header class="topbar">
    <div class="shell topbar-inner">
      <a class="brand" href="/">
        <span class="brand-mark">ꦗ</span>
        <span class="brand-text">
          Jawa Vocab
          <small>Basa Jawa for beginners</small>
        </span>
      </a>
      <nav>
        <a href="/">Home</a>
        <a href="/learn">Learn</a>
        <a href="/games">Games</a>
        <a href="/blog">Blog</a>
      </nav>
    </div>
  </header>

  <main class="shell">
    @yield('content')
  </main>

  <footer class="footer">
    <div class="shell footer-inner">
      <div>
        <strong>Jawa Vocab</strong>
        <div>Stateless practice site — refresh anytime for a fresh round.</div>
      </div>
      <div>Built with Pondoknusa · Blog by rontal</div>
    </div>
  </footer>

  @stack('scripts')
  @echo
</body>
</html>
